rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        isSignedIn() &&
        (
          (request.auth.token.email == 'subdivision513@gmail.com' && request.auth.token.email_verified == true) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Validation Blueprint 1: ProductCatalogItem
    function isValidProductCatalog(data) {
      return data.keys().hasAll([
        'id', 'code', 'name', 'category', 'price',
        'stock', 'initialStock', 'bookedCount',
        'isMadeToOrder', 'isVisible', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'code', 'name', 'category', 'price',
        'stock', 'initialStock', 'bookedCount',
        'isMadeToOrder', 'isVisible', 'updatedAt'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
      data.code is string && data.code.size() >= 1 && data.code.size() <= 32 &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
      data.category in [
        'special_set',
        'cat_1_popular_metal',
        'cat_2_score_metal',
        'cat_3_popular_powder',
        'cat_4_score_powder',
        'royal_project_heritage',
        'commemorative_coin',
        'sacred_powder',
        'bucha_statue'
      ] &&
      data.price is number && data.price > 0 &&
      data.stock is number && data.stock >= 0 &&
      data.initialStock is number && data.initialStock >= 0 &&
      data.bookedCount is number && data.bookedCount >= 0 &&
      data.isMadeToOrder is bool &&
      data.isVisible is bool &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint 2: RajaSetNumberSlot (No PII allowed)
    function isValidRajaSlot(data) {
      return data.keys().hasAll([
        'slotNumber', 'status', 'sessionId',
        'heldAt', 'heldUntil', 'orderNumber', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'slotNumber', 'status', 'sessionId',
        'heldAt', 'heldUntil', 'orderNumber', 'updatedAt'
      ]) &&
      data.slotNumber is number && data.slotNumber >= 1 && data.slotNumber <= 99 &&
      data.status in ['available', 'held', 'booked'] &&
      data.sessionId is string && data.sessionId.size() <= 80 &&
      data.heldAt is number && data.heldAt >= 0 &&
      data.heldUntil is number && data.heldUntil >= 0 &&
      data.orderNumber is string && data.orderNumber.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint 3: ReservationOrder (PII Isolated)
    function isValidReservationOrder(data) {
      return data.keys().hasAll([
        'id', 'orderNumber', 'createdAt', 'reservationDateThai',
        'customerName', 'organization', 'customerPhone', 'shippingAddress',
        'paymentMethod', 'subtotal', 'shippingTotal', 'grandTotal',
        'grandTotalThaiText', 'selectedNumbers', 'itemsJson',
        'paymentStatus', 'sessionId', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'orderNumber', 'createdAt', 'reservationDateThai',
        'customerName', 'organization', 'customerPhone', 'shippingAddress',
        'paymentMethod', 'subtotal', 'shippingTotal', 'grandTotal',
        'grandTotalThaiText', 'selectedNumbers', 'itemsJson',
        'paymentStatus', 'sessionId', 'updatedAt'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
      data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40 &&
      data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 64 &&
      data.reservationDateThai is string && data.reservationDateThai.size() >= 4 && data.reservationDateThai.size() <= 80 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120 &&
      data.organization is string && data.organization.size() >= 1 && data.organization.size() <= 160 &&
      data.customerPhone is string && data.customerPhone.size() >= 9 && data.customerPhone.size() <= 32 &&
      data.shippingAddress is string && data.shippingAddress.size() <= 400 &&
      data.paymentMethod in ['promptpay', 'bank_transfer'] &&
      data.subtotal is number && data.subtotal >= 0 &&
      data.shippingTotal is number && data.shippingTotal >= 0 &&
      data.grandTotal is number && data.grandTotal > 0 &&
      data.grandTotalThaiText is string && data.grandTotalThaiText.size() >= 4 && data.grandTotalThaiText.size() <= 300 &&
      data.selectedNumbers is string && data.selectedNumbers.size() <= 400 &&
      data.itemsJson is string && data.itemsJson.size() >= 2 && data.itemsJson.size() <= 4000 &&
      data.paymentStatus in ['pending_verification', 'verified_paid', 'payment_rejected'] &&
      data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 80 &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    // Connection validation probe path
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // Collection 1: Product Catalog & Real-time Inventory
    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().isVisible == true || isAdmin());
      allow list: if existing().isVisible == true || isAdmin();
      allow create: if isValidId(productId) && isValidProductCatalog(incoming()) && incoming().id == productId;
      allow update: if isValidId(productId) && isValidProductCatalog(incoming()) && incoming().id == existing().id && (
        isAdmin() ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'bookedCount', 'updatedAt']) &&
          incoming().price == existing().price &&
          incoming().code == existing().code &&
          incoming().stock <= existing().stock &&
          incoming().bookedCount >= existing().bookedCount
        )
      );
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Collection 2: Set 1 (ช1) Atomic Number Grid 1-99
    match /rajaSlots/{slotId} {
      allow get: if isValidId(slotId) && existing().slotNumber >= 1 && existing().slotNumber <= 99;
      allow list: if existing().slotNumber >= 1 && existing().slotNumber <= 99;
      allow create: if isValidId(slotId) && isValidRajaSlot(incoming());
      allow update: if isValidId(slotId) && isValidRajaSlot(incoming()) && incoming().slotNumber == existing().slotNumber && (
        isAdmin() ||
        // Action 1: Hold or refresh hold on a non-booked slot
        (
          existing().status != 'booked' &&
          incoming().status == 'held' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sessionId', 'heldAt', 'heldUntil', 'orderNumber', 'updatedAt'])
        ) ||
        // Action 2: Release a held slot back to available (by holding session or after 15-min timeout)
        (
          existing().status == 'held' &&
          incoming().status == 'available' &&
          incoming().orderNumber == '' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sessionId', 'heldAt', 'heldUntil', 'orderNumber', 'updatedAt'])
        ) ||
        // Action 3: Confirm booking on an available or held slot
        (
          existing().status != 'booked' &&
          incoming().status == 'booked' &&
          incoming().orderNumber.size() >= 3 &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sessionId', 'heldAt', 'heldUntil', 'orderNumber', 'updatedAt'])
        ) ||
        // Action 4: Admin/System release of cancelled order slot
        (
          existing().status == 'booked' &&
          incoming().status == 'available' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sessionId', 'heldAt', 'heldUntil', 'orderNumber', 'updatedAt'])
        )
      );
      allow delete: if false;
    }

    // Collection 3: Reservation Orders (Isolated Customer PII)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || existing().sessionId.size() >= 1);
      allow list: if isAdmin() || existing().paymentStatus in ['pending_verification', 'verified_paid', 'payment_rejected'];
      allow create: if isValidId(orderId) && isValidReservationOrder(incoming()) && incoming().id == orderId;
      allow update: if isValidId(orderId) && isValidReservationOrder(incoming()) &&
        incoming().id == existing().id &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'updatedAt']);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Collection 4: Admin Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && request.auth.uid == adminUid;
      allow list, write: if false;
    }
  }
}
